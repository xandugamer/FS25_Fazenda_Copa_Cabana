<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="siloExtension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
			<en>Milk Storage</en>
			<de>Milchlagerung</de>
			<fr>Silos à lait</fr>
		</name>
        <image>store_milkStorage.dds</image>
        <functions>
            <function>$l10n_function_liquidManureTankExtension</function>
        </functions>
        <price>500</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>siloExtensions</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>siloExtensions</tab>
        </brush>
        <storeIconRendering>
            <settings cameraXRot="-25" advancedBoundingBox="true" />
        </storeIconRendering>
        <vertexBufferMemoryUsage>420608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>108544</indexBufferMemoryUsage>
        <textureMemoryUsage>983040</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>milkStorage.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <buysFarmland priceScale="1">false</buysFarmland>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas/>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <siloExtension nearSiloWarning="$l10n_warning_liquidManureTankNotNearBarn">
        <loadingStation node="loadingTrigger" supportsExtension="true" storageRadius="70">
            <loadTrigger triggerNode="loadingTrigger" fillLitersPerSecond="2000" dischargeNode="dischargeNode" fillTypes="MILK" aiNode="aiLoadingNode" />
        </loadingStation>
        <storage node="storage" fillTypes="MILK BUFFALOMILK" capacity="1000000" isExtension="true"/>
    </siloExtension>

    <i3dMappings>
        <i3dMapping id="storage" node="0>6" />
        <i3dMapping id="clearArea1Start" node="0>0|0" />
        <i3dMapping id="clearArea1Width" node="0>0|0|0" />
        <i3dMapping id="clearArea1Height" node="0>0|0|1" />
        <i3dMapping id="testArea1Start" node="0>2|0" />
        <i3dMapping id="testArea1End" node="0>2|0|0" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>3|0|0" />
    </i3dMappings>
</placeable>
