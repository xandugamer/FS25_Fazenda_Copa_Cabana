<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="silo" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
			<en>Filling Area</en>
			<de>Füllbereich</de>
			<fr>Zone de chargement</fr>
		</name>
        <functions>
            <function>$l10n_function_farmSilo</function>
        </functions>
        <image>store_fillTrigger.dds</image>
        <price>100</price>
        <dailyUpkeep>0</dailyUpkeep>
		<canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
	    <species>placeable</species>
        <category>silos</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>silos</tab>
        </brush>
        <vertexBufferMemoryUsage>48384</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>18176</indexBufferMemoryUsage>
        <textureMemoryUsage>131072</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>fillTrigger.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <buysFarmland priceScale="1">false</buysFarmland>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/> 
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height"/>
        </levelAreas>
    </leveling>

    <indoorAreas/>

    <tipOcclusionUpdateAreas/>

    <ai>
        <updateAreas>
            <updateArea startNode="UpdateArea1Start" endNode="UpdateArea1End" />
        </updateAreas>
        <splines>
            <spline node="aiSpline" />
        </splines>
    </ai>
	
    <infoTrigger triggerNode="infoTrigger"/>

    <silo>    
		<loadingStation node="loadingTrigger" supportsExtension="true" storageRadius="25">
			<loadTrigger triggerNode="loadingTrigger" fillLitersPerSecond="5000" dischargeNode="dischargeNode" fillTypes="MILK BUFFALOMILK LIQUIDMANURE" aiNode="aiLoadingNode">
				<effectNode effectClass="PipeEffect" effectNode="pipeEffect"      materialType="pipe"           fadeTime="0.5" maxBending="0" controlPoint="4.8 0 0 0" />
				<effectNode effectNode="pipeEffectSmoke" materialType="unloadingSmoke" fadeTime="0.5" />
			</loadTrigger>
		</loadingStation>
		<unloadingStation/>
		<storages>
            <storage node="storage" fillTypeCategories="liquid" capacity="1000" isExtension="true"/>
		</storages>
    </silo>

    <hotspots/>

    <triggerMarkers>
		<triggerMarker node="markerLoading"   filename="$data/shared/assets/marker/markerIconLoad.i3d"/>
    </triggerMarkers>

    <i3dMappings>        
		<i3dMapping id="clearArea1Start"   node="0>1|0" />
        <i3dMapping id="clearArea1Width"   node="0>1|0|0" />
        <i3dMapping id="clearArea1Height"  node="0>1|0|1" />    
        <i3dMapping id="testArea1Start"    node="0>0|0" />
        <i3dMapping id="testArea1End"      node="0>0|0|0" />  
        <i3dMapping id="UpdateArea1Start"  node="0>2" />
        <i3dMapping id="UpdateArea1End"    node="0>2|0" />
        <i3dMapping id="aiSpline"          node="0>3|2" />	
		<i3dMapping id="markerLoading"     node="0>3|3" />
		<i3dMapping id="infoTrigger"       node="0>3|4" />
		<i3dMapping id="pipeEffect"        node="0>3|0|2|0" />
		<i3dMapping id="aiLoadingNode"     node="0>3|1" />
		<i3dMapping id="dischargeNode"     node="0>3|0|1" />
		<i3dMapping id="pipeEffectSmoke"   node="0>3|0|2|1" />
        <i3dMapping id="storage"           node="0>4" />
		<i3dMapping id="loadingTrigger"    node="0>3|0|0" />
		<i3dMapping id="levelArea1Start"   node="0>7|0" />
        <i3dMapping id="levelArea1Width"   node="0>7|0|0" />
        <i3dMapping id="levelArea1Height"  node="0>7|0|1" />  
	</i3dMappings>
</placeable>